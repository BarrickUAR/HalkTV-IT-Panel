// HalkTV Teknik Destek — Prisma şeması
// Sadece iletişim ve ticket/hata çözme odaklı.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================
enum Role {
  SUPER_ADMIN
  GENEL_YAYIN_YONETMENI
  TEKNIK_MUDUR
  TEKNIK_YONETMEN
  MANAGER
  IT_AGENT
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_REQUESTER
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSource {
  PORTAL
  EMAIL
  PHONE
  SYSTEM
}

enum TicketCategory {
  HARDWARE
  SOFTWARE
  ACCOUNT_ACCESS
  NETWORK
  EMAIL
  OTHER
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnnouncementLevel {
  INFO
  WARNING
  OUTAGE
}

enum WebhookType {
  TEAMS
  SLACK
}

enum NotificationType {
  TICKET_CREATED
  TICKET_ASSIGNED
  TICKET_STATUS
  TICKET_COMMENT
  SLA_WARNING
  APPROVAL_REQUEST
  ANNOUNCEMENT
  DIRECT_MESSAGE
  DEVICE_MESSAGE
}

// ============================================================
// AUTH.JS
// ============================================================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// CORE — Personel
// ============================================================
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  image         String?
  emailVerified DateTime?
  role          Role       @default(EMPLOYEE)
  status        UserStatus @default(ACTIVE)
  title         String?
  phone         String?
  employeeNo    String?    @unique
  username      String?    @unique
  passwordHash  String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  computers    Computer[]
  notes        String?     @db.Text

  managerId String?
  manager   User?   @relation("OrgChart", fields: [managerId], references: [id])
  reports   User[]  @relation("OrgChart")

  accounts Session[]
  authAcc  Account[]

  directMessagesEnabled Boolean @default(true)
  showInLiveChat        Boolean @default(true)

  requestedTickets Ticket[]        @relation("Requester")
  assignedTickets  Ticket[]        @relation("Assignee")
  comments         TicketComment[]
  uploads          Attachment[]
  timeEntries      TimeEntry[]
  auditLogs        AuditLog[]

  notifications Notification[]
  pushSubs      PushSubscription[]
  notifPrefs    NotificationPreference[]
  dmSent        DirectMessage[]          @relation("DMSent")
  dmReceived    DirectMessage[]          @relation("DMReceived")
  deviceMessagesSent DeviceMessage[]     @relation("SentDeviceMessages")
  deviceChatAssignments DeviceConversationAssignment[]
  assetAssignments AssetAssignment[]

  blocking  UserBlock[] @relation("Blocker")
  blockedBy UserBlock[] @relation("Blocked")

  feedbackNotes FeedbackNote[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  lastActiveAt DateTime?

  @@index([role])
  @@index([status])
  @@index([departmentId])
  @@index([lastActiveAt])
}

// ============================================================
// TICKETING
// ============================================================
model Ticket {
  id           String         @id @default(cuid())
  number       String         @unique
  title        String
  description  String         @db.Text
  category     TicketCategory @default(OTHER)
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  source       TicketSource   @default(PORTAL)
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id])

  requesterId String
  requester   User    @relation("Requester", fields: [requesterId], references: [id])
  assigneeId  String?
  assignee    User?   @relation("Assignee", fields: [assigneeId], references: [id])

  requestTypeId String?
  requestType   RequestType? @relation(fields: [requestTypeId], references: [id])
  formData      Json?

  slaDueAt   DateTime?
  resolvedAt DateTime?
  closedAt   DateTime?

  comments    TicketComment[]
  attachments Attachment[]
  approvals   Approval[]
  survey      SatisfactionSurvey?
  timeEntries TimeEntry[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  @@index([status])
  @@index([assigneeId])
  @@index([requesterId])
  @@index([priority])
  @@index([createdAt])
}

model TicketComment {
  id         String            @id @default(cuid())
  ticketId   String
  ticket     Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User              @relation(fields: [authorId], references: [id])
  body       String            @db.Text
  visibility CommentVisibility @default(PUBLIC)

  attachments Attachment[]
  createdAt   DateTime     @default(now())

  @@index([ticketId])
}

model Attachment {
  id         String         @id @default(cuid())
  ticketId   String?
  ticket     Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User           @relation(fields: [uploaderId], references: [id])

  fileName    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([ticketId])
}

model TimeEntry {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  minutes   Int
  note      String?
  spentAt   DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([userId])
}

model RequestType {
  id               String         @id @default(cuid())
  name             String         @unique
  description      String?
  category         TicketCategory @default(OTHER)
  formSchema       Json?
  requiresApproval Boolean        @default(false)
  isActive         Boolean        @default(true)
  tickets          Ticket[]
}

model Approval {
  id         String         @id @default(cuid())
  ticketId   String
  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  approverId String
  status     ApprovalStatus @default(PENDING)
  note       String?
  decidedAt  DateTime?
  createdAt  DateTime       @default(now())

  @@index([ticketId])
  @@index([approverId])
}

model SatisfactionSurvey {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

// ============================================================
// DUYURU / STATUS
// ============================================================
model Announcement {
  id          String            @id @default(cuid())
  title       String
  body        String            @db.Text
  level       AnnouncementLevel @default(INFO)
  isActive    Boolean           @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String
  createdAt   DateTime          @default(now())

  @@index([isActive])
}

model IntegrationWebhook {
  id        String             @id @default(cuid())
  name      String
  type      WebhookType
  url       String
  events    NotificationType[]
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
}

// ============================================================
// BİLDİRİMLER & MESAJLAR
// ============================================================
model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String?
  link       String?
  entityType String?
  entityId   String?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model NotificationPreference {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  emailEnabled Boolean          @default(true)
  pushEnabled  Boolean          @default(true)

  @@unique([userId, type])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("DMSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("DMReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String    @db.Text
  isRead      Boolean   @default(false)
  readAt      DateTime?

  // Dosya eklentisi (opsiyonel)
  attachmentUrl  String?
  attachmentName String?
  attachmentType String? // "image" | "file"

  createdAt DateTime @default(now())

  // Arşiv / silme (konuşma bazlı, gönderen veya alıcı için)
  archivedBySender    Boolean @default(false)
  archivedByRecipient Boolean @default(false)
  deletedBySender     Boolean @default(false)
  deletedByRecipient  Boolean @default(false)

  @@index([senderId, recipientId])
  @@index([recipientId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ============================================================
// KNOWLEDGE BASE (SSS)
// ============================================================
model KnowledgeArticle {
  id          String         @id @default(cuid())
  title       String
  content     String         @db.Text
  category    TicketCategory @default(OTHER)
  isPublished Boolean        @default(true)
  authorId    String
  viewCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([category])
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  floor     String?
  sortOrder Int        @default(0)
  users     User[]
  tickets   Ticket[]
  computers Computer[]
  createdAt DateTime   @default(now())
}

model Computer {
  id            String      @id @default(cuid())
  name          String      @unique
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes         String?     @db.Text
  cpuModel      String?
  totalRam      String?
  freeDiskSpace String?
  domain        String?
  organizationalUnit String?
  ipAddress     String?
  windowsUser   String?
  operatingSystem String?
  inventorySource String @default("MANUAL")
  lastHeartbeatAt DateTime?
  lastAdSyncAt  DateTime?
  kioskVersion  String?
  anyDeskId     String?
  tightVncAvailable Boolean @default(false)
  lastVncConnectedAt DateTime?
  lastVncConnectionStatus String?
  deviceCredential DeviceCredential?
  pairingCode DevicePairingCode?
    deviceConversationMessages DeviceConversationMessage[]
    deviceChatAssignment DeviceConversationAssignment?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt

  @@index([lastHeartbeatAt])
  @@index([lastAdSyncAt])
  @@index([inventorySource])
}

model DeviceConversationMessage {
  id          String    @id @default(cuid())
  computerId  String
  computer    Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)
  direction   String
  body        String    @db.Text
  senderId    String?
  senderName  String
  senderTitle String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([computerId, createdAt])
  @@index([computerId, direction, readAt])
}

model DeviceConversationAssignment {
    id         String   @id @default(cuid())
    computerId String   @unique
    computer   Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)
    assigneeId String
    assignee   User     @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
    assignedAt DateTime @default(now())

    @@index([assigneeId])
}

model DevicePairingCode {
  id           String    @id @default(cuid())
  computerId   String    @unique
  computer     Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)
  codeHash     String
  createdById  String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([expiresAt, usedAt])
}

model RemoteConnection {
  id                 String   @id @default(cuid())
  targetComputerId   String?
  targetComputerName String?
  targetIp           String
  sourceComputerName String?
  actorId            String?
  actorName          String?
  actorTitle         String?
  method             String   @default("TIGHTVNC")
  status             String   @default("REQUESTED")
  error              String?  @db.Text
  createdAt          DateTime @default(now())

  @@index([targetIp, createdAt])
  @@index([actorId, createdAt])
}

model DeviceCredential {
  id          String   @id @default(cuid())
  computerId  String   @unique
  computer    Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  tokenPrefix String
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  rotatedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Asset {
  id              String   @id @default(cuid())
  assetTag        String   @unique
  type            String
  brand           String?
  model           String?
  serialNumber    String?  @unique
  status          String   @default("IN_STOCK")
  location        String?
  warrantyEndsAt  DateTime?
  invoicePath     String?
  notes           String?  @db.Text
  assignments     AssetAssignment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([status])
}

model AssetAssignment {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedAt  DateTime @default(now())
  returnedAt  DateTime?
  note        String?  @db.Text

  @@index([userId, returnedAt])
  @@index([assetId, assignedAt])
}

// ============================================================
// COMPLAINT & SUGGESTION (FEEDBACK)
// ============================================================
enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model Feedback {
  id            String         @id @default(cuid())
  pinCode       String         @unique @default(cuid()) // HTV-9B4X tarzı üretilecek
  type          String // "COMPLAINT" | "SUGGESTION"
  category      String?
  content       String         @db.Text
  attachmentUrl String?
  status        FeedbackStatus @default(NEW)
  isRead        Boolean        @default(false)
  adminResponse String?        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes FeedbackNote[]

  @@index([createdAt])
  @@index([pinCode])
}

model FeedbackNote {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([feedbackId])
}

// ============================================================
// LIVE CHAT BLOCKING
// ============================================================
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// ============================================================
// DEVICE MESSAGING (Aktif Kiosk / Cihaz Mesajlaşma)
// ============================================================
model DeviceMessage {
  id           String    @id @default(cuid())
  computerId   String?
  computerName String
  senderId     String
  sender       User      @relation("SentDeviceMessages", fields: [senderId], references: [id], onDelete: Cascade)
  title        String?
  message      String    @db.Text
  urgent       Boolean   @default(false)
  isRead       Boolean   @default(false)
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([computerName, isRead])
  @@index([createdAt])
}

// ============================================================
// REMOTE DEVICE COMMANDS (IT → C# Client)
// ============================================================
enum DeviceCommandType {
  RESTART
  SHUTDOWN
  RELOAD_KIOSK
  LOCK_SCREEN
  SHOW_MESSAGE
  FLUSH_DNS
  RESET_SPOOLER
  RENEW_IP
  OPEN_APP
  MUTE_AUDIO
  UNMUTE_AUDIO
  SLEEP
  TAKE_SCREENSHOT
  KILL_PROCESS
}

enum DeviceCommandStatus {
  PENDING
  RECEIVED
  EXECUTING
  DONE
  FAILED
}

model DeviceCommand {
  id           String              @id @default(cuid())
  computerName String
  type         DeviceCommandType
  payload      String?
  status       DeviceCommandStatus @default(PENDING)
  result       String?
  senderId     String
  createdAt    DateTime            @default(now())
  expiresAt    DateTime?
  receivedAt   DateTime?
  completedAt  DateTime?

  @@index([computerName, status])
  @@index([status, expiresAt])
  @@index([createdAt])
}

// ============================================================
// SYSTEM EVENTS (C# Client → Server Log)
// ============================================================
model SystemEvent {
  id           String   @id @default(cuid())
  computerName String
  eventType    String
  detail       String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([computerName])
  @@index([createdAt])
}
