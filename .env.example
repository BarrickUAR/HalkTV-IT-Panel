# HalkTV HelpDesk — ortam değişkenleri örneği.
# Bu dosyayı `.env` olarak kopyalayıp doldurun. `.env` git'e gitmez.

# ---- Veritabanı (Supabase Postgres) ----
# Supabase > Project Settings > Database > Connection string
DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ---- Auth.js (NextAuth v5) ----
# Üret: npx auth secret   (veya: openssl rand -base64 33)
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ---- Resend (magic link + bildirim e-postaları) ----
AUTH_RESEND_KEY=""
EMAIL_FROM="HalkTV HelpDesk <helpdesk@halktv.com.tr>"

# ---- Google OAuth (Workspace) ----
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Microsoft Entra ID (M365) ----
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<TENANT_ID>/v2.0"

# ---- Supabase Storage (dosya ekleri) ----
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Web Push (Faz 7) ----
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ---- Cron güvenliği (ZORUNLU) ----
# Üret: openssl rand -hex 32
# Tanımlı değilse /api/cron 503 döner (endpoint asla korumasız çalışmaz).
# Vercel bu değişkeni tanımlıysa cron isteğine otomatik "Bearer <CRON_SECRET>" ekler.
# NOT: Vercel Hobby planında cron GÜNDE 1 KEZ çalışabilir (vercel.json: "0 6 * * *").
# Daha sık çalıştırmak için ücretsiz bir dış zamanlayıcı (ör. cron-job.org) şu isteği atsın:
#   GET https://<alan-adin>/api/cron   header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ---- Uygulama adresi (Teams/Slack bildirim linkleri için) ----
# Boşsa bildirim mesajlarındaki linkler göreli kalır (tıklanamaz).
NEXT_PUBLIC_APP_URL="https://helpdesk.halktv.com.tr"

# ---- E-posta ile talep açma (/api/inbound-email) ----
# E-posta sağlayıcısının inbound webhook'unu korur (header: x-webhook-secret ya da ?secret=).
INBOUND_EMAIL_SECRET=""

# ---- İlk yönetici bootstrap ----
# İlk giriş yaptığında otomatik SUPER_ADMIN olacak e-posta(lar). Virgülle ayır.
SUPER_ADMIN_EMAILS=""
